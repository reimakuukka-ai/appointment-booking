# Google Apps Script web app URL
# Saat tämän kun deployaat Code.gs web appina Apps Scriptissä:
#   1. Avaa Apps Script → Deploy → New deployment
#   2. Type: Web app | Execute as: Me | Who has access: Anyone
#   3. Kopioi URL tänne
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/KORVAA_TAMA/exec

# ============================================================
# BRÄNDÄYS JA TIETOSUOJASELOSTE — valinnaisia, mutta suositellaan
# täytettäväksi jos otat työkalun käyttöön oman organisaatiosi
# nimissä. Ilman näitä sivustolla näkyy Espoon Vihreiden tiedot.
# Ei tarvitse koskea koodiin — kaikki alla luetaan suoraan tänne.
# ============================================================

NEXT_PUBLIC_ORG_NAME=
NEXT_PUBLIC_SITE_TITLE=
NEXT_PUBLIC_SITE_DESCRIPTION=

# Pääbrändiväri HEX-muodossa, esim. #284734. Tumma/vaalea/keskisävy
# lasketaan tästä automaattisesti — ei tarvitse antaa erikseen.
NEXT_PUBLIC_BRAND_COLOR=

# Tietosuojaselosteen (GDPR) rekisterinpitäjätiedot — nämä näkyvät
# varaajille lakisääteisenä tiedotteena. TÄRKEÄÄ: täytä nämä omiksi
# tiedoiksesi äläkä jätä tyhjäksi jos organisaatiosi ei ole Espoon
# Vihreät ry.
NEXT_PUBLIC_PRIVACY_CONTROLLER_NAME=
NEXT_PUBLIC_PRIVACY_CONTROLLER_ADDRESS=
NEXT_PUBLIC_PRIVACY_CONTACT_NAME=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
